{
  "schema_version":"PS-REPO-POLICY-2",
  "default_branch":"main","required_protected":true,"required_pull_request_for_consolidation":true,"forbid_force_push":true,"forbid_branch_deletion":true,
  "required_main_status_contexts":["supernova/branch-consolidate"],
  "inflight_status_contexts":["supernova/branch-generation","supernova/branch-worker","supernova/branch-verify","supernova/branch-integrate"],
  "status_source_rule":"Required main check must be bound by GitHub branch/ruleset configuration to the intended Actions source; textual context alone is insufficient.",
  "worker_forks_default":"FORBIDDEN_UNLESS_DISTINCT_SECURITY_PRINCIPAL",
  "machine_observation_status":"UNVERIFIED_UNTIL_GITHUB_BRANCH_METADATA_REPORTS_PROTECTED_TRUE",
  "fresh_gate":"BLOCK"
}
