{
  "schema_version":"PS-REPO-POLICY-5",
  "default_branch":"main",
  "required_protected":true,
  "required_pull_request_for_consolidation":true,
  "forbid_force_push":true,
  "forbid_branch_deletion":true,
  "required_main_status_contexts":["supernova/static-control","supernova/report-admission","supernova/transition-admission"],
  "required_status_source_creator_logins":["github-actions[bot]"],
  "required_status_checks_strict_up_to_date":true,
  "inflight_diagnostic_contexts":["supernova/branch-generation","supernova/branch-worker","supernova/branch-verify","supernova/branch-integrate","supernova/branch-consolidate"],
  "status_source_rule":"All three required main contexts must be created by the frozen GitHub Actions workflow principal. Textual context equality alone is insufficient and one context never substitutes for another.",
  "admission_authority_contract":"config/admission_authority.json",
  "candidate_code_execution_with_status_write_token":"FORBIDDEN",
  "trusted_candidate_validation_rule":"Candidate bytes are data only under exact accepted-main validator code; authority-changing PRs cannot self-admit.",
  "ruleset_user_confirmation":"USER_CONFIRMED_INSTALLED_2026-08-19",
  "operational_source_binding_proof_required":true,
  "worker_forks_default":"FORBIDDEN_UNLESS_DISTINCT_SECURITY_PRINCIPAL",
  "machine_observation_status":"MAIN_PROTECTED_TRUE; SOURCE_BOUND_ACTIONS_CONTEXTS_AND_STRICT_REQUIRED_STATUS_CHECKS_POLICY_MUST_BE_OBSERVED_BEFORE_COUNTABLE_COHORT",
  "fresh_gate":"BLOCK",
  "calibration_gate":"BLOCK_UNTIL_ACTIONS_SOURCE_CONTEXTS_AND_RULESET_SOURCE_BINDING_OBSERVED_THEN_TWO_CLEAN_V25_COHORTS"
}
