  "required": ["schema_version","protocol_version","task_network_plan_id","status","stage_base_head","active_state_path","active_state_git_identity","active_cohort_id","active_generation_seq","candidate_nonce","candidate_cohort_id","candidate_generation_seq","generation_branch","generation_root_sha","generation_head_sha","control_path","control_git_identity","assignment_path","assignment_git_identity","liveness_path","liveness_git_identity","scheduler_manifest_path","scheduler_manifest_git_identity","scheduler_admission_path","calibration_countable","calibration_credit","fresh_allowed"]
