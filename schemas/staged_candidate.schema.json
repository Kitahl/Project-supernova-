{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PS-STAGED-CANDIDATE-2.5-1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "PS-STAGED-CANDIDATE-2.5-1"},
    "protocol_version": {"const": "2.5"},
    "task_network_plan_id": {"const": "0aa341106cfc5b104ab9ca9c2ae116d490a258685e28d26d5435860c53bb12aa"},
    "status": {"const": "STAGED"},
    "stage_base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "active_state_path": {"const": "state/CURRENT.json"},
    "active_state_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "active_cohort_id": {"type": "string", "minLength": 1},
    "active_generation_seq": {"type": "integer", "minimum": 1},
    "candidate_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_cohort_id": {"type": "string", "minLength": 1},
    "candidate_generation_seq": {"type": "integer", "minimum": 1},
    "generation_branch": {"type": "string", "pattern": "^ps/gen/[^/]+$"},
    "generation_root_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generation_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "control_path": {"type": "string", "pattern": "^control/[^/]+\\.json$"},
    "control_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "assignment_path": {"type": "string", "pattern": "^assignments/[^/]+\\.json$"},
    "assignment_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "liveness_path": {"type": "string", "pattern": "^liveness/[^/]+\\.json$"},
    "liveness_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scheduler_manifest_path": {"type": "string", "pattern": "^scheduler/[^/]+\\.json$"},
    "scheduler_manifest_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scheduler_admission_path": {"type": "string", "pattern": "^scheduler_admission/[^/]+\\.json$"},
    "calibration_countable": {"const": true},
    "calibration_credit": {"const": 0},
    "fresh_allowed": {"const": false}
