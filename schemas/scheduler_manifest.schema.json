{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PS-SCHEDULER-MANIFEST-2.5-1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "PS-SCHEDULER-MANIFEST-2.5-1"},
    "protocol_version": {"const": "2.5"},
    "task_network_plan_id": {"const": "0aa341106cfc5b104ab9ca9c2ae116d490a258685e28d26d5435860c53bb12aa"},
    "candidate_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cohort_id": {"type": "string", "minLength": 1},
    "generation_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "control_manifest_id": {"type": "string", "minLength": 1},
    "control_manifest_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "assignment_id": {"type": "string", "minLength": 1},
    "assignment_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "liveness_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtime_state_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_registry_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timezone": {"const": "America/Vancouver"},
    "scheduler_cadence_seconds": {"type": "integer", "minimum": 3600},
    "max_attempt_duration_seconds": {"type": "integer", "minimum": 1},
    "scheduler_jitter_budget_seconds": {"type": "integer", "minimum": 0},
    "production_not_before_utc": {"type": "string", "format": "date-time"},
    "admission_cutoff_utc": {"type": "string", "format": "date-time"},
    "tasks": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role_id": {"enum": ["MF01","MF02","MF03","MF04","MF05","MM01","MM02","MM03","MM04","MM05","MM07","EXT01","MM06","MF06","BIL00"]},
          "canonical_title": {"type": "string", "minLength": 1},
          "scheduler_task_id": {"type": "string", "minLength": 1},
          "enabled": {"const": true},
          "behavioral_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "timing_mode": {"const": "exact_schedule"},
          "default_timezone": {"const": "America/Vancouver"},
          "normalized_schedule": {"type": "string", "minLength": 1},
          "normalized_first_production_utc": {"type": "string", "format": "date-time"},
          "normalized_second_production_utc": {"type": "string", "format": "date-time"},
          "production_branch": {"type": "string", "minLength": 1},
          "production_path": {"type": "string", "minLength": 1},
          "execution_mode": {"type": "string", "minLength": 1},
          "worker_auth_commitment": {"type": ["string","null"], "pattern": "^[0-9a-f]{64}$"},
          "preactivation_branch": {"type": "string", "minLength": 1},
          "preactivation_path": {"type": "string", "minLength": 1},
          "challenge_occurrences_utc": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "format": "date-time"}
          }
        },
        "required": ["role_id","canonical_title","scheduler_task_id","enabled","behavioral_config_sha256","prompt_sha256","timing_mode","default_timezone","normalized_schedule","normalized_first_production_utc","normalized_second_production_utc","production_branch","production_path","execution_mode","worker_auth_commitment","preactivation_branch","preactivation_path","challenge_occurrences_utc"]
      }
    },
    "behavioral_config_projection": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["task_id","title","prompt_sha256","normalized_schedule","timing_mode","default_timezone","enabled"]}
    },
    "mutable_runtime_fields_excluded": {
      "type": "array",
      "contains": {"const": "last_run_time"}
    },
    "active_cohort_constructive_repair": {"const": "FORBIDDEN"},
    "stage_admit_promote": {"const": "THREE_DISTINCT_TRANSACTIONS"},
    "raw_auth_material_publication": {"const": "FORBIDDEN"}
  },
  "required": ["schema_version","protocol_version","task_network_plan_id","candidate_nonce","cohort_id","generation_head_sha","control_manifest_id","control_manifest_git_identity","assignment_id","assignment_git_identity","liveness_git_identity","runtime_state_id","task_registry_git_identity","timezone","scheduler_cadence_seconds","max_attempt_duration_seconds","scheduler_jitter_budget_seconds","production_not_before_utc","admission_cutoff_utc","tasks","behavioral_config_projection","mutable_runtime_fields_excluded","active_cohort_constructive_repair","stage_admit_promote","raw_auth_material_publication"]
}
