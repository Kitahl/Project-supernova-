  "required": ["schema_version","protocol_version","task_network_plan_id","candidate_nonce","cohort_id","generation_root_sha","generation_head_sha","staged_candidate_git_identity","scheduler_manifest_git_identity","source_preactivation_admission_branch","source_preactivation_admission_path","source_preactivation_admission_commit_sha","source_preactivation_admission_blob_sha","source_schema_version","admission_verdict","creation_mode"]
