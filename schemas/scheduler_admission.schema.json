    "generation_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "staged_candidate_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scheduler_manifest_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scheduler_inventory_branch": {"type": "string", "pattern": "^ps/preactivate/[^/]+/BIL00$"},
    "scheduler_inventory_path": {"type": "string", "pattern": "^preactivation/[^/]+/BIL00\\.json$"},
    "scheduler_inventory_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scheduler_inventory_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "mm06_scheduler_task_id": {"type": "string", "minLength": 1},
    "mm06_behavioral_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mm06_challenge_occurrence_utc": {"type": "string", "format": "date-time"},
