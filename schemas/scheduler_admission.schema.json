        "required": ["role_id","preactivation_branch","preactivation_path","receipt_blob_sha","receipt_creation_commit_sha","scheduler_task_id_valid","behavioral_config_valid","challenge_timing_valid","worker_commitment_valid","worker_hmac_valid","mm06_verifier_copy_commitment_valid","production_write_absent"]
      }
