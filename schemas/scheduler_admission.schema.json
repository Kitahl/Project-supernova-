    "scheduler_manifest_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_preactivation_admission_branch": {"type": "string", "pattern": "^ps/preactivate/[^/]+/MM06$"},
    "source_preactivation_admission_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_preactivation_admission_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "mm06_scheduler_task_id": {"type": "string", "minLength": 1},
    "mm06_behavioral_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_registry_exact_15_verified": {"const": true},
    "no_replacement_task_verified": {"const": true},
    "normalized_schedule_readback_verified": {"const": true},
    "timezone_binding_verified": {"const": true},
    "retry_slack_formula_verified": {"const": true},
    "production_branches_unchanged_from_generation_head": {"const": true},
    "preactivation_branch_isolation_verified": {"const": true},
    "create_once_prewrite_guards_verified": {"const": true},
    "worker_results": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role_id": {"enum": ["MF01","MF02","MF03","MF04","MF05","MM01","MM02","MM03","MM04","MM05","MM07","EXT01"]},
          "preactivation_branch": {"type": "string", "minLength": 1},
          "preactivation_path": {"type": "string", "minLength": 1},
          "receipt_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "receipt_creation_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "scheduler_task_id_valid": {"const": true},
          "behavioral_config_valid": {"const": true},
          "challenge_timing_valid": {"const": true},
          "worker_commitment_valid": {"const": true},
          "worker_hmac_valid": {"const": true},
          "mm06_verifier_copy_commitment_valid": {"const": true},
          "production_write_absent": {"const": true}
