{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PS-SCHEDULER-ADMISSION-2.5-3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "PS-SCHEDULER-ADMISSION-2.5-3"},
    "protocol_version": {"const": "2.5"},
    "task_network_plan_id": {"const": "0aa341106cfc5b104ab9ca9c2ae116d490a258685e28d26d5435860c53bb12aa"},
    "candidate_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
