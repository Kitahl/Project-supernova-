    "partition_exhaustive_verified": {"const": true},
    "admission_verdict": {"const": "SCHEDULER_ADMISSION_PASS"},
    "fresh_evidence_consumed": {"const": false},
    "scientific_state_effect": {"const": "NONE"},
    "runtime_effect": {"const": "NONE"},
