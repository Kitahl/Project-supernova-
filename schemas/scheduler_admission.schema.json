        "required": ["role_id","preactivation_branch","preactivation_path","receipt_blob_sha","receipt_creation_commit_sha","scheduler_task_id_valid","behavioral_config_valid","challenge_timing_valid","role_commitment_valid","role_hmac_valid","mm06_verifier_copy_commitment_valid","production_write_absent"]
      }
    },
    "partition_exhaustive_verified": {"const": true},
    "admission_verdict": {"const": "SCHEDULER_ADMISSION_PASS"},
    "fresh_evidence_consumed": {"const": false},
    "scientific_state_effect": {"const": "NONE"},
    "runtime_effect": {"const": "NONE"},
    "required_post_write_ci_context": {"const": "supernova/preactivation-admission"}
