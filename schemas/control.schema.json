{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Supernova Branch Generation Control v2.5 root11 stageable",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "calibration_countable": {"type": "boolean"},
    "candidate_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cohort_id": {"type": "string"},
    "control_manifest_id": {"type": "string"},
    "control_release_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "control_release_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "deep_research_owner": {"const": "BIL00"},
    "expected_base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fresh_allowed": {"type": "boolean"},
    "generation_root_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generation_seq": {"type": "integer", "minimum": 1},
    "parent_state_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "protocol_version": {"const": "2.5"},
    "purpose": {"type": "string"},
    "repo_policy_required": {"const": true},
    "required_control_paths": {"type": "array", "minItems": 20, "uniqueItems": true, "items": {"type": "string"}},
    "scheduler_admission_required": {"const": true},
    "scheduler_manifest_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scheduler_manifest_path": {"type": "string", "pattern": "^scheduler/[^/]+\\.json$"},
    "task_network_plan_id": {"const": "0aa341106cfc5b104ab9ca9c2ae116d490a258685e28d26d5435860c53bb12aa"},
    "worker_auth_scheme": {"const": "PS-HMAC-SHA256-CANONICAL-REPORT-2"}
  },
  "allOf": [
    {
      "if": {"required": ["candidate_nonce"]},
      "then": {
        "required": ["candidate_nonce", "generation_root_sha", "expected_base_head", "scheduler_manifest_path", "scheduler_admission_required"],
        "not": {"required": ["scheduler_manifest_git_identity"]}
      }
    }
  ],
  "required": [
    "control_manifest_id", "task_network_plan_id", "cohort_id", "protocol_version", "generation_seq",
    "parent_state_git_identity", "control_release_commit_sha", "control_release_tree_sha", "required_control_paths",
    "purpose", "calibration_countable", "fresh_allowed", "repo_policy_required", "worker_auth_scheme", "deep_research_owner"
  ]
}
