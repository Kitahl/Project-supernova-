{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Supernova Strict Issue Record v2.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_id",
    "severity",
    "component",
    "status",
    "classification",
    "summary",
    "exact_failure",
    "evidence_refs",
    "blocker",
    "proposed_protocol_2_5_fix_test",
    "required_test",
    "owner",
    "authoritative_control_change",
    "next_action"
  ],
  "properties": {
    "issue_id": {"type": "string", "minLength": 1},
    "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "component": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "minLength": 1},
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "summary": {"type": "string", "minLength": 1},
    "exact_failure": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "blocker": {"type": "boolean"},
    "proposed_protocol_2_5_fix_test": {"type": "string", "minLength": 1},
    "required_test": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "authoritative_control_change": {"type": "boolean"},
    "next_action": {"type": "string", "minLength": 1}
  }
}
