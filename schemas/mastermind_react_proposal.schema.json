{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastermind React Proposal Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "mechanism_id",
    "preservation_obligations",
    "observer_contract",
    "task_contract",
    "contamination_controls",
    "mutation_security_envelope",
    "authority_boundary",
    "provenance_refs",
    "execution_artifact_ref",
    "evaluator_ref",
    "complete_cost_envelope_ref",
    "negative_controls",
    "proposal_only",
    "self_promotion_allowed"
  ],
  "properties": {
    "schema_version": {"const": "PS-MASTERMIND-REACT-PROPOSAL-1"},
    "proposal_id": {"type": "string", "minLength": 1},
    "mechanism_id": {"type": "string", "minLength": 1},
    "preservation_obligations": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "observer_contract": {"type": "object", "additionalProperties": false, "required": ["observer_id", "blindness_scope", "read_only"], "properties": {"observer_id": {"type": "string", "minLength": 1}, "blindness_scope": {"type": "string", "minLength": 1}, "read_only": {"const": true}}},
    "task_contract": {"type": "object", "additionalProperties": false, "required": ["task_class", "allowed_inputs", "forbidden_outputs"], "properties": {"task_class": {"type": "string", "minLength": 1}, "allowed_inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "forbidden_outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
    "contamination_controls": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "mutation_security_envelope": {"type": "object", "additionalProperties": false, "required": ["mutation_scope", "forbidden_paths", "security_review_required", "unsafe_expansion_allowed"], "properties": {"mutation_scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "forbidden_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "security_review_required": {"const": true}, "unsafe_expansion_allowed": {"const": false}}},
    "authority_boundary": {"type": "object", "additionalProperties": false, "required": ["proposal_authority", "execution_authority", "evaluation_authority", "scientific_promotion_authority"], "properties": {"proposal_authority": {"const": "MM01_PRE_REVIEW_ONLY"}, "execution_authority": {"type": "string", "minLength": 1}, "evaluation_authority": {"type": "string", "minLength": 1}, "scientific_promotion_authority": {"const": "NOT_MM01"}}},
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "execution_artifact_ref": {"type": "string", "minLength": 1},
    "evaluator_ref": {"type": "string", "minLength": 1},
    "complete_cost_envelope_ref": {"type": "string", "minLength": 1},
    "negative_controls": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "proposal_only": {"const": true},
    "self_promotion_allowed": {"const": false}
  }
}
