{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SN QuerySpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_id", "candidate_or_intervention_set", "witness_class", "horizon", "continuation_policy_family", "material_error", "risk_allocation", "complete_cost_budget", "semantic_version", "support_population"],
  "properties": {
    "query_id": {"type": "string"},
    "candidate_or_intervention_set": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "witness_class": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "horizon": {"type": "integer", "minimum": 1},
    "continuation_policy_family": {"type": "string"},
    "material_error": {"type": "number", "minimum": 0},
    "risk_allocation": {"type": "object"},
    "complete_cost_budget": {"type": "number", "minimum": 0},
    "semantic_version": {"type": "string"},
    "support_population": {"type": "string"}
  }
}
