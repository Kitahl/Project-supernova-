{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CohortLivenessContract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["cohort_id", "generation_head_sha", "lanes"],
  "properties": {
    "cohort_id": {"type": "string"},
    "generation_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "lanes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lane_id", "branch", "path", "expected_window_start_utc", "deadline_utc"],
        "properties": {
          "lane_id": {"type": "string"},
          "branch": {"type": "string"},
          "path": {"type": "string"},
          "expected_window_start_utc": {"type": "string"},
          "deadline_utc": {"type": "string"},
          "eligible_before_deadline": {"type": "boolean"}
        }
      }
    }
  }
}
