{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CohortLivenessContract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_network_plan_id",
    "cohort_id",
    "generation_seq",
    "generation_head_sha",
    "assignment_id",
    "assignment_git_identity",
    "control_manifest_id",
    "control_manifest_git_identity",
    "lanes"
  ],
  "properties": {
    "schema_version": {"const": "PS-COHORT-LIVENESS-CONTRACT-2"},
    "task_network_plan_id": {"const": "0aa341106cfc5b104ab9ca9c2ae116d490a258685e28d26d5435860c53bb12aa"},
    "cohort_id": {"type": "string", "minLength": 1},
    "generation_seq": {"type": "integer", "minimum": 1},
    "generation_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "assignment_id": {"type": "string", "minLength": 1},
    "assignment_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "control_manifest_id": {"type": "string", "minLength": 1},
    "control_manifest_git_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "lanes": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane_id",
          "branch",
          "path",
          "expected_window_start_utc",
          "deadline_utc",
          "eligible_before_deadline"
        ],
        "properties": {
          "lane_id": {"enum": ["MF01","MF02","MF03","MF04","MF05","MM01","MM02","MM03","MM04","MM05","MM07","EXT01"]},
          "branch": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "expected_window_start_utc": {"type": "string", "format": "date-time"},
          "deadline_utc": {"type": "string", "format": "date-time"},
          "eligible_before_deadline": {"const": true}
        }
      }
    }
  }
}
