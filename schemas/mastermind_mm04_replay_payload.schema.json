{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastermind MM04 Replay Architecture Payload v2.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "architecture_result", "evaluator_execution_status", "architecture_checks", "nonvacuity_checks", "provenance_checks", "self_promotion"],
  "properties": {
    "schema_version": {"const": "PS-MM04-REPLAY-PAYLOAD-2.5-1"},
    "architecture_result": {
      "type": "object", "additionalProperties": false,
      "required": ["result_type", "status", "value", "reason"],
      "properties": {
        "result_type": {"const": "SCIENTIFIC_METRIC"}, "status": {"const": "NOT_MEASURED"}, "value": {"const": null},
        "reason": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "unit": {"type": ["string", "null"]}
      }
    },
    "evaluator_execution_status": {"const": "NOT_EXECUTED"},
    "architecture_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "nonvacuity_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "self_promotion": {"const": false}
  }
}
