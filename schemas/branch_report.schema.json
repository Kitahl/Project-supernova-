{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Supernova Branch Worker Report v2.5",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "IssueRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "severity",
        "component",
        "status",
        "evidence_refs",
        "blocker",
        "proposed_fix",
        "required_test",
        "owner",
        "authoritative_control_change",
        "next_action"
      ],
      "properties": {
        "issue_id": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blocker": {"type": "string"},
        "proposed_fix": {"type": "string"},
        "required_test": {"type": "string"},
        "owner": {"type": "string", "minLength": 1},
        "authoritative_control_change": {"type": "boolean"},
        "next_action": {"type": "string"}
      }
    },
    "MetricResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "reason", "evidence_refs"],
      "properties": {
        "status": {"enum": ["MEASURED", "NOT_MEASURED", "UNKNOWN", "NOT_APPLICABLE"]},
        "value": {"type": ["number", "null"]},
        "reason": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "MEASURED"}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "number"}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["NOT_MEASURED", "UNKNOWN", "NOT_APPLICABLE"]}}, "required": ["status"]},
          "then": {"properties": {"value": {"const": null}}}
        }
      ]
    }
  },
  "required": [
    "session_header","task_network_plan_id","cohort_id","worker_id","report_id","generation_seq","generation_head_sha","worker_branch","assignment_id","assignment_git_identity","parent_state_git_identity","control_manifest_id","control_manifest_git_identity","network_checkpoint_id","runtime_state_id","visibility_token","worker_auth_scheme","worker_auth_commitment","worker_auth_proof","status","mode","evidence_tier","executive_status","fresh_evidence_ids","private_manifest_id","private_manifest_git_identity","task_ledger","issue_ledger","test_ledger","plan_alignment","evidence_and_provenance","claim_scope","runtime_implementation_implication","negative_zero_outcomes","research_questions","cost_ledger","public_safety_status","origin_reread_claim","next_action"
  ],
  "properties": {
    "session_header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version","session_name","target_program","phase","iteration_id","iteration_number","role_id","goal","plan_id","runtime_state_id","model_target","reasoning_effort_target","model_binding_status","execution_mode"],
      "properties": {
        "schema_version":{"const":"PS-SESSION-2"},
        "session_name":{"type":"string"},
        "target_program":{"enum":["MATH_FOUNDRY","MASTERMIND","JOINT"]},
        "phase":{"type":"string"},
        "iteration_id":{"type":"string"},
        "iteration_number":{"type":"integer","minimum":1},
        "role_id":{"type":"string"},
        "goal":{"type":"string"},
        "plan_id":{"const":"0aa341106cfc5b104ab9ca9c2ae116d490a258685e28d26d5435860c53bb12aa"},
        "runtime_state_id":{"type":"string"},
        "model_target":{"const":"GPT-5.6 Sol"},
        "reasoning_effort_target":{"const":"EXTRA_HIGH"},
        "model_binding_status":{"enum":["VERIFIED","PARTIAL_UNVERIFIED","UNVERIFIED","MISMATCH"]},
        "execution_mode":{"enum":["SAFE_REPLAY_ONLY","FRESH_EXECUTION","WAITING","RESEARCH"]}
      }
    },
    "task_network_plan_id":{"const":"0aa341106cfc5b104ab9ca9c2ae116d490a258685e28d26d5435860c53bb12aa"},
    "cohort_id":{"type":"string"},
    "worker_id":{"enum":["MF01","MF02","MF03","MF04","MF05","MM01","MM02","MM03","MM04","MM05","MM07","EXT01"]},
    "report_id":{"type":"string"},
    "generation_seq":{"type":"integer","minimum":1},
    "generation_head_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "worker_branch":{"type":"string"},
    "assignment_id":{"type":"string"},
    "assignment_git_identity":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "parent_state_git_identity":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "control_manifest_id":{"type":"string"},
    "control_manifest_git_identity":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "network_checkpoint_id":{"type":"string"},
    "runtime_state_id":{"type":"string"},
    "visibility_token":{"type":"string"},
    "worker_auth_scheme":{"const":"PS-HMAC-SHA256-CANONICAL-REPORT-2"},
    "worker_auth_commitment":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "worker_auth_proof":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "status":{"const":"VALID_ASSIGNED_REPORT"},
    "mode":{"enum":["SAFE_REPLAY_ONLY","FRESH_EXECUTION"]},
    "evidence_tier":{"type":"string"},
    "executive_status":{"type":"string"},
    "fresh_evidence_ids":{"type":"array","items":{"type":"string"}},
    "private_manifest_id":{"type":["string","null"]},
    "private_manifest_git_identity":{"type":["string","null"]},
    "task_ledger":{"type":"array"},
    "issue_ledger":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/IssueRecord"}},
    "test_ledger":{"type":"array"},
    "plan_alignment":{"type":"array"},
    "evidence_and_provenance":{"type":"object"},
    "claim_scope":{"type":"string"},
    "runtime_implementation_implication":{"type":"string"},
    "negative_zero_outcomes":{"type":"array"},
    "research_questions":{"type":"array"},
    "role_payload":{"type":"object","additionalProperties":true},
    "cost_ledger": {
      "type":"object","additionalProperties":false,
      "required":["fresh_evidence_units_consumed","protected_manifest_reads","benchmark_executions","deep_research_runs","notes"],
      "properties": {
        "fresh_evidence_units_consumed":{"type":"integer","minimum":0},
        "protected_manifest_reads":{"type":"integer","minimum":0},
        "benchmark_executions":{"type":"integer","minimum":0},
        "deep_research_runs":{"const":0},
        "notes":{"type":"string"}
      }
    },
    "public_safety_status":{"const":"PASS"},
    "origin_reread_claim":{"const":false},
    "next_action":{"type":"string"}
  },
  "allOf": [
    {
      "if": {"properties": {"worker_id": {"const": "MM03"}}, "required": ["worker_id"]},
      "then": {
        "required": ["role_payload"],
        "properties": {
          "role_payload": {
            "type": "object",
            "required": ["metric_results"],
            "properties": {
              "metric_results": {
                "type": "object",
                "additionalProperties": false,
                "required": ["slopcode_contract_result"],
                "properties": {
                  "slopcode_contract_result": {"$ref": "#/$defs/MetricResult"}
                }
              }
            }
          }
        }
      }
    }
  ]
}
