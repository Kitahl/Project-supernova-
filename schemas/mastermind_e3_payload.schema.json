{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastermind MM05 E3 Control Payload v2.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "arm", "artifact_sha256", "evaluator_id", "evaluator_version",
    "security_envelope_id", "mutation_envelope_id", "matched_envelope_verified",
    "complete_cost_binding", "seed_set", "scoring_contract_id", "origin_task_promotion"
  ],
  "properties": {
    "schema_version": {"const": "PS-MM05-E3-PAYLOAD-2.5-1"},
    "arm": {"enum": ["LEARNED_PROPOSAL", "RANDOM_ADMISSIBLE", "NO_CHANGE_EQUAL_COMPUTE"]},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_id": {"type": "string", "minLength": 1},
    "evaluator_version": {"type": "string", "minLength": 1},
    "security_envelope_id": {"type": "string", "minLength": 1},
    "mutation_envelope_id": {"type": "string", "minLength": 1},
    "matched_envelope_verified": {"const": true},
    "complete_cost_binding": {"const": "REPORT_COST_LEDGER_COMPLETE"},
    "seed_set": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "scoring_contract_id": {"type": "string", "minLength": 1},
    "origin_task_promotion": {"const": false}
  }
}
