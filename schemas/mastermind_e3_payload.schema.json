{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastermind MM05 E3 Three-Arm Control Payload v2.5 r2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "shared_execution_context", "seed_set", "scoring_contract_id", "arms", "matched_envelope_verified", "origin_task_promotion"],
  "properties": {
    "schema_version": {"const": "PS-MM05-E3-PAYLOAD-2.5-2"},
    "experiment_id": {"type": "string", "minLength": 1},
    "shared_execution_context": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_state_id", "task_identity", "model_tools_identity", "proposal_budget_identity", "execution_budget_identity", "cache_retention_identity", "security_envelope_id", "mutation_envelope_id"],
      "properties": {
        "runtime_state_id": {"type": "string", "minLength": 1},
        "task_identity": {"type": "string", "minLength": 1},
        "model_tools_identity": {"type": "string", "minLength": 1},
        "proposal_budget_identity": {"type": "string", "minLength": 1},
        "execution_budget_identity": {"type": "string", "minLength": 1},
        "cache_retention_identity": {"type": "string", "minLength": 1},
        "security_envelope_id": {"type": "string", "minLength": 1},
        "mutation_envelope_id": {"type": "string", "minLength": 1}
      }
    },
    "seed_set": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "scoring_contract_id": {"type": "string", "minLength": 1},
    "arms": {
      "type": "object", "additionalProperties": false,
      "required": ["LEARNED_PROPOSAL", "RANDOM_ADMISSIBLE", "NO_CHANGE_EQUAL_COMPUTE"],
      "properties": {
        "LEARNED_PROPOSAL": {"$ref": "#/$defs/arm"},
        "RANDOM_ADMISSIBLE": {"$ref": "#/$defs/arm"},
        "NO_CHANGE_EQUAL_COMPUTE": {"$ref": "#/$defs/arm"}
      }
    },
    "matched_envelope_verified": {"const": true},
    "origin_task_promotion": {"const": false}
  },
  "$defs": {
    "complete_cost": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_compute", "execution_compute", "model_tokens", "tool_calls", "feature_probe_compute", "selection_compute", "wall_seconds"],
      "properties": {
        "proposal_compute": {"type": "number", "minimum": 0}, "execution_compute": {"type": "number", "minimum": 0},
        "model_tokens": {"type": "integer", "minimum": 0}, "tool_calls": {"type": "integer", "minimum": 0},
        "feature_probe_compute": {"type": "number", "minimum": 0}, "selection_compute": {"type": "number", "minimum": 0}, "wall_seconds": {"type": "number", "minimum": 0}
      }
    },
    "arm": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_sha256", "evaluator_id", "evaluator_version", "complete_cost", "raw_outcome_ref"],
      "properties": {
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "evaluator_id": {"type": "string", "minLength": 1}, "evaluator_version": {"type": "string", "minLength": 1},
        "complete_cost": {"$ref": "#/$defs/complete_cost"}, "raw_outcome_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
