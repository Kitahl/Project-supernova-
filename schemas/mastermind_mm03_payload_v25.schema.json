{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastermind MM03 Typed Missingness Payload v2.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slopcode_result"],
  "properties": {
    "schema_version": {"const": "PS-MM03-PAYLOAD-2.5-2"},
    "slopcode_result": {"$ref": "#/$defs/metric_result"}
  },
  "$defs": {
    "metric_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "status", "value", "reason", "evidence_refs", "unit"],
      "properties": {
        "result_type": {"const": "SCIENTIFIC_METRIC"},
        "status": {"enum": ["MEASURED", "NOT_MEASURED", "UNKNOWN", "NOT_APPLICABLE"]},
        "value": {"type": ["number", "null"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "unit": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "MEASURED"}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "number"}}},
          "else": {"properties": {"value": {"const": null}}}
        }
      ]
    }
  }
}
